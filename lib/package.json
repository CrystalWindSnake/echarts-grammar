{
  "name": "echarts-grammar",
  "version": "0.1.5",
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./simplified": {
      "import": "./dist/simplified/index.js",
      "types": "./dist/simplified/index.d.ts"
    },
    "./simplified/builders": {
      "import": "./dist/simplified/builders/index.js",
      "types": "./dist/simplified/builders/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:types": "tsc --emitDeclarationOnly && tsc-alias",
    "prepublishOnly": "npm run build && npm run build:types",
    "publish": "nrm use npm && npm publish && nrm use tencent"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.5.2",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "echarts": "^6.0.0"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "lodash-es": "^4.17.21"
  }
}